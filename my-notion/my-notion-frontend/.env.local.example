# Must be byte-identical to my-notion-backend's AUTH_SECRET (spine AD-5).
AUTH_SECRET="change-me-to-a-long-random-string"

# Must be byte-identical to my-notion-backend's INTERNAL_API_SECRET.
INTERNAL_API_SECRET="change-me-to-a-different-long-random-string"

BACKEND_URL="http://localhost:3001"

# Google OAuth Client ID/Secret — from Google Cloud Console.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
