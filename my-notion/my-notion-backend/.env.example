DATABASE_URL="postgresql://user:password@localhost:5432/my_notion_dev?schema=public"

# Shared with my-notion-frontend — must be byte-identical in both apps (spine AD-5).
AUTH_SECRET="change-me-to-a-long-random-string"

# Shared with my-notion-frontend — gates verify-credentials/oauth-google so only
# the frontend's server-side Auth.js code can call them (see InternalApiGuard).
INTERNAL_API_SECRET="change-me-to-a-different-long-random-string"

PORT=3001

# --- Image upload (FR-9) ---

# Directory on the server's local disk volume where uploaded images are stored.
# MUST be inside the FR-14 backup set that story 6 builds: a pg_dump restores
# the `assets` rows but NOT the image bytes they point at, so a backup that
# skips this directory leaves every restored Page with broken images.
# See README "Image storage & backup (FR-9 / FR-14)".
ASSET_STORAGE_DIR="./var/assets"

# Public origin the *browser* reaches the app at. Used to build the absolute
# image URL that gets stored in `pages.content` (spine AD-2: `src` is always an
# absolute URL, never a relative path or embedded base64).
#
# This is my-notion-frontend's origin, not this backend's: per AD-1/AD-5 the
# browser never talks to the backend directly, and an <img> tag cannot attach a
# Bearer token — so images are loaded through the frontend Route Handler
# (/api/assets/:id), which reads the Auth.js session cookie and proxies here.
#
# Changing this after images exist does NOT rewrite URLs already saved in page
# content — set it to the real public origin before uploading anything real.
PUBLIC_APP_URL="http://localhost:3000"
