// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// spec-1-auth Code Map: model User (id uuid, email, password_hash, google_id nullable,
// failed_login_attempts int default 0, locked_until timestamp nullable)
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String?   @map("password_hash")
  googleId            String?   @unique @map("google_id")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  pages  Page[]
  assets Asset[]

  @@map("users")
}

// spec-2-page-crud-tree Code Map: model Page (id uuid, parentId nullable
// self-relation `onDelete: Cascade` per spine AD-3, ownerId, title, content
// jsonb default empty, viewType default "document", viewSchema nullable
// jsonb, createdAt, updatedAt). content/viewType/viewSchema are created here
// per the spine ERD but NOT used by this story (story 3/8/9) — avoids a
// re-migration later.
model Page {
  id       String  @id @default(uuid())
  parentId String? @map("parent_id")
  parent   Page?   @relation("PageToChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Page[]  @relation("PageToChildren")

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id])

  title String

  // AD-2: content is a single Tiptap JSON document; not authored in this
  // story — new pages get an empty document.
  content Json @default("{}")

  // AD-7: document | table | kanban | calendar — this story only ever
  // creates/reads "document"; view_schema stays null.
  viewType   String @default("document") @map("view_type")
  viewSchema Json?  @map("view_schema")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([parentId])
  @@map("pages")
}

// spec-4-image-upload Code Map: model Asset (id uuid, ownerId, original
// filename, mimeType, sizeBytes, storagePath, createdAt).
//
// The row is the access-control record for an uploaded image: `GET /assets/:id`
// filters by (id, ownerId) so another user's asset 404s (never 403 — same
// no-existence-leak rule pages follow).
//
// The bytes live on the server's local disk volume, NOT in Postgres (spec
// "Always": local disk, no S3/paid cloud storage). `storagePath` is the path
// *relative to* ASSET_STORAGE_DIR — storing it relative keeps rows valid when
// the volume is remounted at a different absolute path (e.g. host vs Docker
// container), and keeps a DB dump portable.
//
// FR-14/story 6 constraint: ASSET_STORAGE_DIR must be inside the backup set.
// A pg_dump alone restores these rows but NOT the image bytes they point at.
model Asset {
  id String @id @default(uuid())

  ownerId String @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id])

  /// Original client-supplied name — metadata only (shown as the image's
  /// `alt`). Never used to build a filesystem path: the on-disk name is the
  /// generated uuid plus an extension derived from the *sniffed* mime type,
  /// so a hostile "../../etc/passwd" filename can't escape the storage root.
  filename String

  /// Detected from the file's magic bytes at upload time, not from the
  /// client-declared Content-Type. This is what `GET /assets/:id` serves back.
  mimeType String @map("mime_type")

  sizeBytes   Int    @map("size_bytes")
  storagePath String @map("storage_path")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([ownerId])
  @@map("assets")
}
