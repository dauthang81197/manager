# Copy this file to `pg_backup.env` next to backup.sh/restore.sh on the VPS
# (NOT in this repo) and fill in the real password for the `manager_app_1`
# Postgres role. backup.sh/restore.sh pass it to `docker exec --env-file`,
# never as a CLI argument, so it never leaks into `ps`/shell history.
#
#   chmod 600 pg_backup.env   # readable only by the user cron runs the job as
#
PGPASSWORD=changeme
